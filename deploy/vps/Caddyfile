# Caddy gets and renews Let's Encrypt certificates for every site below by
# itself, once each domain's DNS A record points at this server.
# Values come from the caddy service's environment (compose.vps.yml).
{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output stdout
		format console
	}
}

# Only the owner's eyes: LabFlow's, FinancePowerApp's and PharmaFlow's demo
# sign-ins have no password, and LedgerDashboard holds the job search
# (companies, contacts).
(private) {
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
}

# Control Panel: public, with its own login (hand out the viewer account).
{$PANEL_DOMAIN} {
	import common
	reverse_proxy frontend:80
}

# ReBiomed marketplace: public demo.
{$REBIOMED_DOMAIN} {
	import common
	reverse_proxy rebiomed-web:80
}

# English collocation lessons: public (also on GitHub Pages). Its Context tab
# finds no /api/context here and says it is local-only. /api/sync is the
# review-progress sync (lessons-sync checks its own X-Sync-Key).
{$LESSONS_DOMAIN} {
	import common
	respond /api/context* 404
	handle /api/sync* {
		reverse_proxy lessons-sync:8080
	}
	handle {
		reverse_proxy lessons-web:80
	}
}

# The same lessons app as the owner's private Context reader (the phone's
# home-screen app). /api/context is the context engine's export, pushed from
# the PC by push-context.ps1 into CONTEXT_DIR; it is never in the image.
{$CONTEXT_DOMAIN} {
	import common
	import private
	handle /api/context {
		root * /srv/context
		rewrite * /context.json
		header Cache-Control no-store
		file_server
	}
	handle /api/sync* {
		reverse_proxy lessons-sync:8080
	}
	handle {
		reverse_proxy lessons-web:80
	}
}

# ClinicReport: public demo (synthetic data, one-click demo users, nightly
# reset). Caddy proxies the SignalR WebSocket on /hubs as is.
{$CLINICREPORT_DOMAIN} {
	import common
	reverse_proxy clinicreport:8080
}

{$LABFLOW_DOMAIN} {
	import common
	import private
	reverse_proxy labflow-web:80
}

# ClinicHub: public demo (synthetic clinics, one-click sign-in, accounts and
# clinics locked). Its OpenID Connect endpoints need the HTTPS Caddy gives.
{$HUB_DOMAIN} {
	import common
	reverse_proxy clinichub:8080
}

# FinancePowerApp and PharmaFlow: demo data, but both still run on their
# development sign-in (anyone who reaches them is the developer).
{$FINANCE_DOMAIN} {
	import common
	import private
	reverse_proxy finance-web:80
}

{$PHARMACY_DOMAIN} {
	import common
	import private
	reverse_proxy pharmaflow-web:80
}

{$LEDGER_DOMAIN} {
	import common
	import private
	reverse_proxy ledgerdashboard:4310
}
