# The server's /srv/portfolio/ControlPanel/.env (git-ignored). Copy this
# file there, fill in every value, then `chmod 600 .env`.
# Random secrets:  openssl rand -base64 48
# NEW values, not the ones from your PC: the old DB password is in git history.

COMPOSE_FILE=docker-compose.yml:compose.apps.yml:deploy/vps/compose.vps.yml

# ---------------------------------------------------------------- Caddy --
# Let's Encrypt contacts this address about certificate problems.
ACME_EMAIL=
# One DNS A record per name, all pointing at the server's IP.
PANEL_DOMAIN=panel.example.com
REBIOMED_DOMAIN=rebiomed.example.com
LABFLOW_DOMAIN=labflow.example.com
LEDGER_DOMAIN=ledger.example.com
# Basic auth in front of LabFlow and LedgerDashboard. Hash:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the SINGLE quotes: the hash contains $ signs.
BASIC_AUTH_USER=arash
BASIC_AUTH_HASH=''

# ------------------------------------------------------- Control Panel --
SA_PASSWORD=
DB_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
ANTHROPIC_API_KEY=
ADMIN_PASSWORD=
VIEWER_PASSWORD=
LEDGER_READER_PASSWORD=
# The Azure demo accepts any key; the adapter still needs a value.
WUTILITY_API_KEY=azure-demo-needs-no-key-but-the-adapter-sends-one
# WUTILITY_API_BASE=https://wutility-arash.azurewebsites.net

# ---------------------------------------------------------------- Apps --
DEPLOY_DIR=/srv/portfolio/ControlPanel/deploy
LEDGERDASH_DIR=/srv/portfolio/LedgerDashboard
# Copied from the PC with scp (not in git): see README.md.
JOBSEARCH_DIR=/srv/portfolio/JobSearch
LEDGERDASH_PASSWORD=
LEDGERDASH_SESSION_SECRET=
REBIOMED_DIR=/srv/portfolio/Rebiomed
REBIOMED_JWT_SECRET=
REBIOMED_STRIPE_SECRET_KEY=
REBIOMED_STRIPE_PUBLISHABLE_KEY=
LABFLOW_DIR=/srv/portfolio/LabFlow
# LabFlow isn't on GitHub yet: create the repo, push, and put its URL here.
LABFLOW_REPO=https://github.com/ArashKeshtgar/LabFlow.git
LABFLOW_DB_PASSWORD=
