{
  "name": "hisplus-adapter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "jest"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "ts-node-dev": "^2.0.0",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$"
  }
}
