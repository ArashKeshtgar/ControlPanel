DB_SERVER=localhost
DB_NAME=ControlPanelDb
DB_USER=controlpanel_svc
DB_PASSWORD=
# Two different random values, 32+ characters each. The app refuses to start
# without them. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# Optional: enables the AI assistant (POST /assistant/ask).
ANTHROPIC_API_KEY=
# Hosts an adapter base URL may point at (SSRF allowlist). Comma-separated.
ADAPTER_ALLOWED_HOSTS=localhost,127.0.0.1
# Only read by `npm run seed:users`. 12+ characters each.
ADMIN_PASSWORD=
VIEWER_PASSWORD=

# Optional: comma-separated browser origins allowed to call the API (default http://localhost:4100).
# CORS_ORIGINS=http://localhost:4100
# Optional: Docker socket proxy for the Services page; set by docker-compose.yml. Unset = /services answers 503.
# DOCKER_PROXY_URL=http://socket-proxy:2375
