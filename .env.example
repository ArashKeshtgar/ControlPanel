# Copy to .env (git-ignored) and fill in every value before `docker compose up`.
# Generate random secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

# SQL Server sa password for the container (8+ chars, upper, lower, digit, symbol).
SA_PASSWORD=
# Password for the controlpanel_svc login that core-api and hisplus-adapter use.
DB_PASSWORD=
# Two different random values, 32+ characters each.
JWT_SECRET=
JWT_REFRESH_SECRET=
# Optional: enables the AI assistant; leave empty to run without it.
ANTHROPIC_API_KEY=
# Passwords for the two built-in accounts (admin, viewer), 12+ characters each.
ADMIN_PASSWORD=
VIEWER_PASSWORD=
# Password of LedgerDashboard's read-only ledger_reader login (its db/05-reader-login.sql).
LEDGER_READER_PASSWORD=
# Must match the key wUtility Web's API was started with (32+ characters).
WUTILITY_API_KEY=
# Optional: host port for the frontend (default 4100).
FRONTEND_PORT=

# Apps layer (compose.apps.yml), optional. COMPOSE_FILE makes a plain
# `docker compose up` include it (";" on Windows, ":" elsewhere).
# COMPOSE_FILE=docker-compose.yml;compose.apps.yml
LEDGERDASH_DIR=
JOBSEARCH_DIR=
LEDGERDASH_PORT=
# The LedgerDashboard login (12+ chars) and its session secret (32+ chars).
LEDGERDASH_PASSWORD=
LEDGERDASH_SESSION_SECRET=
# Absolute path of this repo's deploy/ folder (Dockerfiles for ReBiomed and LabFlow).
DEPLOY_DIR=
# ReBiomed (marketplace): repo folder, host port, JWT secret (32+ chars),
# optional Stripe test keys.
REBIOMED_DIR=
REBIOMED_PORT=
REBIOMED_JWT_SECRET=
REBIOMED_STRIPE_SECRET_KEY=
REBIOMED_STRIPE_PUBLISHABLE_KEY=
# LabFlow (lab system): repo folder, host port, and the labflow_svc password
# (deploy/labflow/sql-login.sql).
LABFLOW_DIR=
LABFLOW_PORT=
LABFLOW_DB_PASSWORD=
# English lessons (LanguageLessonDesigner): repo folder, web and sync host ports.
LESSONS_DIR=
LESSONS_PORT=
LESSONS_SYNC_PORT=
# ClinicReport (public demo): repo folder (default ../ClinicReport) and host port.
CLINICREPORT_DIR=
CLINICREPORT_PORT=
# FinancePowerApp (accounting): repo folder, host port for its web UI, the
# finance_svc and finance_reader passwords (deploy/finance/sql-login.sql).
FINANCE_DIR=
FINANCE_PORT=
FINANCE_DB_PASSWORD=
FINANCE_READER_PASSWORD=
# PharmaFlow (pharmacy, the Drugstore repo): repo folder, host port, the
# pharmaflow_svc password (deploy/pharmaflow/sql-login.sql).
PHARMAFLOW_DIR=
PHARMAFLOW_PORT=
PHARMAFLOW_DB_PASSWORD=
# labflow-adapter's read-only login (deploy/labflow/reader-login.sql).
LABFLOW_READER_PASSWORD=
# ClinicHub (clinic platform): repo folder (default ../ClinicHub), host port
# (default 5300), the clinichub_svc password (deploy/clinichub/sql-login.sql).
CLINICHUB_DIR=
CLINICHUB_PORT=
CLINICHUB_DB_PASSWORD=
