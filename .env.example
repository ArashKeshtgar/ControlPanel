# Copy to .env (git-ignored) and fill in every value before `docker compose up`.
# Generate random secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

# SQL Server sa password for the container (8+ chars, upper, lower, digit, symbol).
SA_PASSWORD=
# Password for the controlpanel_svc login that core-api and hisplus-adapter use.
DB_PASSWORD=
# Two different random values, 32+ characters each.
JWT_SECRET=
JWT_REFRESH_SECRET=
# Optional: enables the AI assistant; leave empty to run without it.
ANTHROPIC_API_KEY=
# Passwords for the two built-in accounts (admin, viewer), 12+ characters each.
ADMIN_PASSWORD=
VIEWER_PASSWORD=
# Password of LedgerDashboard's read-only ledger_reader login (its db/05-reader-login.sql).
LEDGER_READER_PASSWORD=
# Must match the key wUtility Web's API was started with (32+ characters).
WUTILITY_API_KEY=
# Optional: host port for the frontend (default 4100).
FRONTEND_PORT=

# Apps layer (compose.apps.yml), optional. COMPOSE_FILE makes a plain
# `docker compose up` include it (";" on Windows, ":" elsewhere).
# COMPOSE_FILE=docker-compose.yml;compose.apps.yml
LEDGERDASH_DIR=
JOBSEARCH_DIR=
LEDGERDASH_PORT=
# The LedgerDashboard login (12+ chars) and its session secret (32+ chars).
LEDGERDASH_PASSWORD=
LEDGERDASH_SESSION_SECRET=
# Absolute path of this repo's deploy/ folder (Dockerfiles for ReBiomed and LabFlow).
DEPLOY_DIR=
# ReBiomed (marketplace): repo folder, host port, JWT secret (32+ chars),
# optional Stripe test keys.
REBIOMED_DIR=
REBIOMED_PORT=
REBIOMED_JWT_SECRET=
REBIOMED_STRIPE_SECRET_KEY=
REBIOMED_STRIPE_PUBLISHABLE_KEY=
# LabFlow (lab system): repo folder, host port, and the labflow_svc password
# (deploy/labflow/sql-login.sql).
LABFLOW_DIR=
LABFLOW_PORT=
LABFLOW_DB_PASSWORD=
LESSONS_DIR=
LESSONS_PORT=
# Analytics (reporting and forecasts): repo folder (default ../Analytics), web port (5601: ClinicHub's
# registered redirect), the read-only FinancePowerApp connection string
# (Server=host.docker.internal,1433;...;UID=analytics_reader;...), how often
# the scheduler runs (30m, 6h, 1d), and, for --profile events, RabbitMQ.
ANALYTICS_DIR=
ANALYTICS_PORT=
ANALYTICS_FINANCE_CONNECTION_STRING=
ANALYTICS_RUN_EVERY=
ANALYTICS_RABBITMQ_URL=
# IntegrationHub (message hub between the clinic applications): repo folder (default ../IntegrationHub), the web port
# (5701: ClinicHub's registered redirect), the API port (5700). The database password, the secrets that switch on the
# de-identified event feed (32+ characters) and HL7 (queue key: openssl rand -base64 32, and ClinicHub's secret for the
# client `integrationhub`) and an alert webhook are optional; empty = off. See the hub's README.
INTEGRATIONHUB_DIR=
INTEGRATIONHUB_PORT=
INTEGRATIONHUB_API_PORT=
INTEGRATIONHUB_DB_PASSWORD=
INTEGRATIONHUB_EVENTS_ENABLED=
INTEGRATIONHUB_EVENTS_PSEUDONYM_SECRET=
INTEGRATIONHUB_HL7_ENABLED=
INTEGRATIONHUB_HL7_QUEUE_KEY=
INTEGRATIONHUB_CLINICHUB_CLIENT_SECRET=
INTEGRATIONHUB_ALERTS_WEBHOOK_URL=
